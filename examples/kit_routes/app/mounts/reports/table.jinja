<section
  id="report-table"
  class="report-table"
  data-fragment="report-table"
  data-period="{{ selected_period }}"
  aria-label="{{ report.heading }} table">
  <h2>{{ report.audience }} report table</h2>
  <p>Selected period: <strong>{{ selected_period }}</strong></p>
  <table>
    <thead>
      <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
    </thead>
    <tbody>
      {% for row in report.rows %}
      <tr><td>{{ row.metric }}</td><td>{{ row.value }}</td><td>{{ row.note }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>

