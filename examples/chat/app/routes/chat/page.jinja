{% if not name %}
<section class="card stack">
  <h1>Pyganini Chat</h1>
  <p>Enter a display name before joining the room.</p>
  <p><a href="{{ root_url }}">Go to the start page</a></p>
</section>
{% else %}
<section class="card stack">
  <header class="chat-header">
    <div>
      <p class="eyebrow">Named SSE events</p>
      <h1>Pyganini Chat</h1>
      <p>Joined as <strong>{{ name }}</strong>.</p>
    </div>
    <form method="post" action="{{ sign_out_url }}">
      <button class="secondary-button" type="submit">Sign out</button>
    </form>
  </header>
  <div
    id="messages"
    class="chat-log"
    hx-sse:connect="{{ events_url }}"
    pyganini-sse-event="chat-message"
    hx-config='{"sse":{"pauseOnBackground":false}}'
    hx-swap="beforeend scroll:bottom">
    {% for message in messages %}{% include "routes/chat/message.jinja" %}{% endfor %}
  </div>
  {% include "routes/chat/composer.jinja" %}
</section>
{% endif %}
