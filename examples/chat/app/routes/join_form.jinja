<form id="join-form" method="post" action="{{ join_url }}">
  <div class="field">
    <label for="name">Name</label>
    <input id="name" name="name" value="{{ form.name }}" autocomplete="name">
  </div>
  {% if form.name_error %}<p class="error">{{ form.name_error }}</p>{% endif %}
  <button type="submit">Enter chat</button>
</form>
